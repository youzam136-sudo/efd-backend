{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Feature_Image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Slug": {
      "type": "uid",
      "targetField": "Title",
      "required": true
    },
    "Excerpt": {
      "type": "text"
    },
    "Author": {
      "type": "string"
    },
    "Date": {
      "type": "date",
      "required": true
    },
    "Content": {
      "type": "customField",
      "customField": "plugin::cms-editor.blocknote"
    }
  }
}
